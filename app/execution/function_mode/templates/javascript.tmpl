  function drvDouble(x) {
    let s;
    const r = x * 1e5;
    // exact ties (x * 64 is whole): round half to even, as C, Python, Java and Go do
    if (Number.isInteger(x * 64) && Math.abs(r) < 9e15 && r - Math.floor(r) === 0.5) {
      const f = Math.floor(r);
      s = ((f % 2 === 0 ? f : f + 1) / 1e5).toFixed(5);
    } else {
      s = x.toFixed(5);
