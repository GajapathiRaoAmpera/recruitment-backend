        const lo = t === 'int' ? -(2n ** 31n) : -(2n ** 63n);
        if (v < lo || v > -lo - 1n) throw 'a whole number that fits in ' + (t === 'int' ? '32' : '64') + ' bits';
        return v.toString();
      }
      if (typeof v !== 'number' || !Number.isInteger(v)) throw 'a whole number';
      if (t === 'int' && (v < -2147483648 || v > 2147483647)) throw 'a whole number that fits in 32 bits';
      return Number.isSafeInteger(v) ? String(v) : BigInt(v).toString();
    }
    if (t === 'double') {
