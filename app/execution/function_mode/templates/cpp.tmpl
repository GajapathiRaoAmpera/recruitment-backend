    explicit In(const std::string &line) : s(line) {}
    void ws() {
        while (i < s.size() && (s[i] == ' ' || s[i] == '\t' || s[i] == '\r' || s[i] == '\n')) i++;
    }
    char peek() { ws(); return i < s.size() ? s[i] : '\0'; }
