APP_ENV=dev
# Azure Postgres: postgresql://USER:PASSWORD@HOST:5432/DB?ssl=require (URL-encode @:/#? in the password;
# postgresql:// is switched to asyncpg automatically)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
# Schema with our tables. Azure shared DB: campushire (create it first: create schema campushire)
DB_SCHEMA=public
# Signs staff sessions and set-password links. SERVER ONLY, never in git: `openssl rand -hex 32`
# Changing it signs everyone out (and ends open student sessions: change it between drives).
JWT_SECRET=
# Staff invite / reset emails. Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords). Empty user/password => email not configured
# (invites then return a link to share instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Where invite emails send new staff to set their password
FRONTEND_URL=http://localhost:3000
# Code runs: self-hosted Judge0. `make judge0-up` starts it (infra/judge0/README.md)
JUDGE0_URL=http://localhost:2358
# Any long random string, e.g. `openssl rand -hex 24`. Judge0 is started with it and the API sends it. Never in git
JUDGE0_AUTH_TOKEN=change-me

# Round 1 Technical questions: one free key from build.nvidia.com (models and NVIDIA_RPM: app/core/config.py)
NVIDIA_API_KEY=
# Round 3 AI interview (Gemini Live voice). SERVER ONLY: the browser only ever gets a one-use ephemeral token.
# Key from aistudio.google.com. A 40-minute audio interview uses a lot of quota: batches need a paid key.
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_VOICE=Kore
