APP_ENV=dev
# Supabase: Connect → Session pooler URI, pasted as-is (postgresql:// is switched to asyncpg automatically)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
# Supabase project URL (not secret): https://<project-ref>.supabase.co — used to fetch JWT signing keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → Secret key. SERVER ONLY: never in the frontend or git
SUPABASE_SECRET_KEY=sb_secret_xxx
# Where invite emails send new staff to set their password
FRONTEND_URL=http://localhost:3000
# Question-bank PDFs (local disk shortcut: mount a volume in containers). Size limit in MB
QBANK_DIR=storage/qbank
QBANK_MAX_MB=20
# Embedding vector size; must match question_embeddings.embedding (migration 0003: vector(768))
EMBEDDING_DIM=768
# Gemini embedding model for question-bank search (uses GEMINI_API_KEY; no key = banks are not
# embedded and focus ranking is off). Bare id or "models/<id>" (the prefix is stripped).
# Changing it requires re-embedding every bank.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

GEMINI_API_KEY=
 
GROQ_API_KEY=