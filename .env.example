APP_ENV=dev
# Supabase: Connect → Session pooler URI, pasted as-is (postgresql:// is switched to asyncpg automatically)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
# Supabase project URL (not secret): https://<project-ref>.supabase.co — used to fetch JWT signing keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → Secret key. SERVER ONLY: never in the frontend or git
SUPABASE_SECRET_KEY=sb_secret_xxx
# Where invite emails send new staff to set their password
FRONTEND_URL=http://localhost:3000
# Round 1 paper builder LLMs. SERVER ONLY: never in the frontend or git. Leave a key empty to
# disable that provider (paper generation then returns 503 AI_PROVIDER_NOT_CONFIGURED).
# Gemini (generator): Google AI Studio -> Get API key
GEMINI_API_KEY=
# Groq (blind verifier): console.groq.com -> API Keys
GROQ_API_KEY=
# Model ids (check the providers' model pages for current ids), e.g. gemini-3.6-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.6-flash
# e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
