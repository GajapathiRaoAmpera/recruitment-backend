APP_ENV=dev
# Supabase: Connect → Session pooler URI, pasted as-is (postgresql:// is switched to asyncpg automatically)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
# Supabase project URL (not secret): https://<project-ref>.supabase.co — used to fetch JWT signing keys
SUPABASE_URL=https://your-project-ref.supabase.co
