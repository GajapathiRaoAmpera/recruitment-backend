APP_ENV=dev
# Supabase: Connect → Session pooler URI, pasted as-is (postgresql:// is switched to asyncpg automatically)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
# Supabase project URL (not secret): https://<project-ref>.supabase.co — used to fetch JWT signing keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → Secret key. SERVER ONLY: never in the frontend or git
SUPABASE_SECRET_KEY=sb_secret_xxx
# Where invite emails send new staff to set their password
FRONTEND_URL=http://localhost:3000
# Question-bank PDFs (local disk shortcut: mount a volume in containers). Size limit in MB
QBANK_DIR=storage/qbank
QBANK_MAX_MB=20
# Question-bank search embeddings: free local model (fastembed, no API key), downloaded once
# (~90 MB) into EMBEDDING_CACHE_DIR on first use. EMBEDDING_DIM must match migration 0004's vector(384);
# changing the model needs a new migration and re-embedding every bank.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=storage/models
# Code runs: self-hosted Judge0. `make judge0-up` starts it (infra/judge0/README.md)
JUDGE0_URL=http://localhost:2358
# Any long random string, e.g. `openssl rand -hex 24`. Judge0 is started with it and the API sends it. Never in git
JUDGE0_AUTH_TOKEN=change-me

GEMINI_API_KEY=
 
GROQ_API_KEY=